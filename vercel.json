{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "h2-softskills.vercel.app" }],
      "destination": "https://www.h2softskills.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain" }]
    }
  ]
}